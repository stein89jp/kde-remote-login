# Local-source bundle is generated by scripts/prepare-release.py.
# Build without -i/-s: never install dependencies or this package on the host.
pkgname=kde-remote-login
pkgver=1.7.0
pkgrel=1
pkgdesc='KDE Plasma RDP host bridge and PAM/logind session broker'
arch=('x86_64')
# Bridge source is MIT; the combined binary links Arch's GPL-licensed FFmpeg.
license=('MIT' 'GPL-3.0-only')
options=('!debug' '!lto')
depends=('pam' 'systemd' 'systemd-libs' 'dbus' 'wayland' 'libxkbcommon'
         'xkeyboard-config' 'ttf-dejavu' 'ffmpeg' 'mesa' 'libglvnd'
         'openssl' 'python' 'python-gobject' 'glib2'
         'pipewire' 'libpipewire' 'pipewire-audio' 'pipewire-pulse' 'wireplumber' 'libpulse'
         # Stock Plasma 6 desktop: KWin's virtual backend with Xwayland, the
         # Plasma shell and session (plasma_session, ksmserver, kded6) and portals.
         'kwin' 'xorg-xwayland' 'plasma-workspace' 'plasma-desktop' 'kded'
         'xdg-desktop-portal' 'xdg-desktop-portal-kde')
makedepends=('rust>=1.94' 'cargo' 'gcc' 'pkgconf' 'python')
backup=('etc/kde-rdp/frontend.conf' 'etc/kde-rdp/renderer.conf' 'etc/kde-rdp/broker.conf' 'etc/pam.d/kde-rdp')
source=("kde-remote-login-$pkgver.tar.gz")
sha256sums=('@SOURCE_SHA256@')

prepare() {
  cd "$srcdir/kde-remote-login-$pkgver"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo fetch --locked --manifest-path bridge/Cargo.toml
  python scripts/collect-licenses.py bridge/Cargo.toml THIRD-PARTY-NOTICES.txt
}

build() {
  cd "$srcdir/kde-remote-login-$pkgver"
  export CARGO_HOME="$srcdir/cargo-home"
  # aws-lc builds jitterentropy at -O0. Exported makepkg CFLAGS append -O2
  # after that per-file override; let upstream cc-rs own its C build flags.
  env -u CFLAGS -u CXXFLAGS cargo build --release --locked --offline --manifest-path bridge/Cargo.toml
  make -C broker
}

check() {
  cd "$srcdir/kde-remote-login-$pkgver"
  export CARGO_HOME="$srcdir/cargo-home"
  env -u CFLAGS -u CXXFLAGS cargo test --locked --offline --manifest-path bridge/Cargo.toml
  make -C broker check
  python -m unittest tests.test_host_setup tests.test_session_environment tests.test_native_video tests.test_audio tests.test_microphone tests.test_performance_harness -v
}

package() {
  cd "$srcdir/kde-remote-login-$pkgver"
  install -Dm755 "${CARGO_TARGET_DIR:-$srcdir/kde-remote-login-$pkgver/bridge/target}/release/kde-rdp-bridge" "$pkgdir/usr/lib/kde-rdp/kde-rdp-bridge"
  install -Dm755 "${CARGO_TARGET_DIR:-$srcdir/kde-remote-login-$pkgver/bridge/target}/release/encoder-probe" "$pkgdir/usr/lib/kde-rdp/encoder-probe"
  make -C broker DESTDIR="$pkgdir" install
  for unit in packaging/systemd/*.service; do
    install -Dm644 "$unit" "$pkgdir/usr/lib/systemd/system/${unit##*/}"
  done
  install -Dm644 packaging/kde-rdp.sysusers "$pkgdir/usr/lib/sysusers.d/kde-rdp.conf"
  install -Dm644 packaging/frontend.conf "$pkgdir/etc/kde-rdp/frontend.conf"
  install -Dm755 packaging/kde-rdp-setup.py "$pkgdir/usr/bin/kde-rdp-setup"
  install -Dm755 packaging/prepare-tls.py "$pkgdir/usr/lib/kde-rdp/prepare-tls"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD-PARTY-NOTICES.txt "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.txt"
  install -Dm644 docs/install.md "$pkgdir/usr/share/doc/$pkgname/install.md"
  install -Dm644 docs/acceptance.md "$pkgdir/usr/share/doc/$pkgname/acceptance.md"
  install -Dm644 docs/upgrade.md "$pkgdir/usr/share/doc/$pkgname/upgrade.md"
  install -Dm644 docs/uninstall.md "$pkgdir/usr/share/doc/$pkgname/uninstall.md"
  install -Dm644 docs/performance.md "$pkgdir/usr/share/doc/$pkgname/performance.md"
  install -Dm644 packaging/nvidia-frontend.conf "$pkgdir/usr/share/doc/$pkgname/nvidia-frontend.conf"
  # fail2ban examples; the package never enables them.
  install -Dm644 packaging/fail2ban/kde-rdp.conf "$pkgdir/usr/share/doc/$pkgname/fail2ban/kde-rdp.conf"
  install -Dm644 packaging/fail2ban/kde-rdp.jail.example "$pkgdir/usr/share/doc/$pkgname/fail2ban/kde-rdp.jail.example"
}
