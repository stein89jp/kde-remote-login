# Build the complete host package directly from a repository checkout:
#   cd packaging/arch/kde-rdp && makepkg -si
# Local inputs are copied and checksum-verified by makepkg, never built in place.
# Export a portable source bundle with makepkg --allsource.
pkgname=kde-remote-login
pkgver=1.6.0
pkgrel=1
pkgdesc='KDE Plasma remote desktop host (KWin virtual backend) with a PAM/logind broker'
arch=('x86_64')
# Bridge source is MIT; the combined binary links Arch's GPL-licensed FFmpeg.
license=('MIT' 'GPL-3.0-only')
options=('!debug' '!lto')
depends=('pam' 'systemd' 'systemd-libs' 'dbus' 'wayland' 'libxkbcommon'
         'xkeyboard-config' 'ttf-dejavu' 'ffmpeg' 'mesa' 'libglvnd'
         'openssl' 'python' 'python-gobject' 'glib2'
         'pipewire' 'libpipewire' 'pipewire-audio' 'pipewire-pulse' 'wireplumber' 'libpulse'
         # Stock Plasma 6 desktop: KWin's virtual backend with Xwayland, the
         # Plasma shell and session (plasma_session, ksmserver, kded6) and portals.
         'kwin' 'xorg-xwayland' 'plasma-workspace' 'plasma-desktop' 'kded'
         'xdg-desktop-portal' 'xdg-desktop-portal-kde')
makedepends=('rust>=1.94' 'cargo' 'gcc' 'pkgconf')
backup=('etc/kde-rdp/frontend.conf' 'etc/kde-rdp/renderer.conf' 'etc/kde-rdp/broker.conf' 'etc/pam.d/kde-rdp')
source=()
sha256sums=()
noextract=()

# A checkout is the source of this local package. Snapshot each required input
# using file:// sources and real checksums; this also includes local edits.
# Evaluation only reads files. Downloads, copying and extraction remain under
# makepkg's control. No Python or Cargo is needed before dependency resolution.
_checkout="${startdir:-$PWD}/../../.."
_local_files=()
if [[ -f "$_checkout/bridge/Cargo.lock" && -f "$_checkout/LICENSE" ]]; then
  _checkout=$(cd "$_checkout" && pwd -P)
  _local_files=(LICENSE README.md bridge/Cargo.toml bridge/Cargo.lock bridge/build.rs
                broker/Makefile broker/broker.c broker/tests.c
                packaging/frontend.conf packaging/nvidia-frontend.conf
                packaging/kde-rdp.sysusers packaging/kde-rdp-setup.py
                packaging/prepare-tls.py scripts/collect-licenses.py
                packaging/fail2ban/kde-rdp.conf packaging/fail2ban/kde-rdp.jail.example
                scripts/loopback_link.py tests/test_performance_harness.py
                tests/__init__.py tests/test_host_setup.py tests/test_session_environment.py
                tests/test_native_video.py tests/video_guard.c tests/video_rate.c tests/video_avc444.c tests/video_gpu.c tests/video_config.c tests/test_audio.py tests/test_microphone.py tests/audio_codec.c tests/audio_rdpsnd.c)
  while IFS= read -r -d '' _file; do
    _local_files+=("${_file#"$_checkout/"}")
  done < <(find "$_checkout/bridge/src" "$_checkout/bridge/tests" "$_checkout/bridge/vendor" "$_checkout/bridge/protocols" \
                "$_checkout/broker/config" \
                "$_checkout/packaging/systemd" "$_checkout/docs" \
                -type f ! -name '*.pyc' -print0 | sort -z)
  for _file in "${_local_files[@]}"; do
    # '+' encodes directory separators in makepkg's flat source directory.
    [[ $_file != *+* ]] || { printf 'Unsupported source path: %s\n' "$_file" >&2; return 1; }
    _digest=$(sha256sum "$_checkout/$_file") || return 1
    _digest=${_digest%% *}
    # Changed checkout inputs get new cache names, avoiding stale source reuse.
    _name="repo-$_digest-${_file//\//+}"
    # Encode spaces and percent signs for curl's file URL parser.
    _url="$_checkout/$_file"
    _url="${_url//%/%25}"
    _url="${_url// /%20}"
    _url="${_url//#/%23}"
    _url="${_url//\?/%3F}"
    source+=("$_name::file://$_url")
    sha256sums+=("$_digest")
    noextract+=("$_name")
  done
else
  # makepkg --allsource bundles contain the same verified inputs, flattened.
  # This permits rebuilding that bundle without the original checkout.
  for _file in "${startdir:-$PWD}"/repo-*; do
    [[ -f $_file ]] || continue
    _name=${_file##*/}
    _relative=${_name#repo-}
    _local_files+=("${_relative#*-}")
    # The source filename carries the checksum captured at bundle creation.
    _digest=${_relative%%-*}
    source+=("$_name")
    sha256sums+=("$_digest")
    noextract+=("$_name")
  done
  [[ ${#_local_files[@]} -gt 0 ]] || {
    printf 'Build this PKGBUILD inside the KDE-RDP checkout, or from a makepkg --allsource bundle.\n' >&2
    return 1
  }
fi

prepare() {
  local input relative
  mkdir -p "$srcdir/kde-remote-login-$pkgver"
  # A reused src tree keeps files deleted from the checkout (old patches, or
  # bridge/src/wayland.rs beside wayland/mod.rs), so start from exactly the
  # current snapshot. Only the bridge's Cargo target survives, for rebuild speed.
  find "$srcdir/kde-remote-login-$pkgver" -mindepth 1 -maxdepth 1 ! -name bridge -exec rm -rf {} +
  if [[ -d "$srcdir/kde-remote-login-$pkgver/bridge" ]]; then
    find "$srcdir/kde-remote-login-$pkgver/bridge" -mindepth 1 -maxdepth 1 ! -name target -exec rm -rf {} +
  fi
  for input in "${source[@]}"; do
    input=${input%%::*}
    relative=$input
    relative=${relative#repo-}
    relative=${relative#*-}
    relative=${relative//+/\/}
    install -Dm644 "$srcdir/$input" "$srcdir/kde-remote-login-$pkgver/$relative"
  done

  export CARGO_HOME="$srcdir/cargo-home"
  cd "$srcdir/kde-remote-login-$pkgver"
  cargo fetch --locked --manifest-path bridge/Cargo.toml
  python scripts/collect-licenses.py bridge/Cargo.toml THIRD-PARTY-NOTICES.txt
}

build() {
  export CARGO_HOME="$srcdir/cargo-home"
  cd "$srcdir/kde-remote-login-$pkgver"
  # aws-lc's jitterentropy requires -O0; let cc-rs control its per-file flags.
  env -u CFLAGS -u CXXFLAGS cargo build --release --locked --offline --manifest-path bridge/Cargo.toml
  make -C broker
}

check() {
  export CARGO_HOME="$srcdir/cargo-home"
  cd "$srcdir/kde-remote-login-$pkgver"
  env -u CFLAGS -u CXXFLAGS cargo test --locked --offline --manifest-path bridge/Cargo.toml
  make -C broker check
  python -m unittest tests.test_host_setup tests.test_session_environment tests.test_native_video tests.test_audio tests.test_microphone tests.test_performance_harness -v
}

package() {
  cd "$srcdir/kde-remote-login-$pkgver"
  install -Dm755 "${CARGO_TARGET_DIR:-$srcdir/kde-remote-login-$pkgver/bridge/target}/release/kde-rdp-bridge" "$pkgdir/usr/lib/kde-rdp/kde-rdp-bridge"
  install -Dm755 "${CARGO_TARGET_DIR:-$srcdir/kde-remote-login-$pkgver/bridge/target}/release/encoder-probe" "$pkgdir/usr/lib/kde-rdp/encoder-probe"
  make -C broker DESTDIR="$pkgdir" install
  local unit document
  for unit in packaging/systemd/*.service; do
    install -Dm644 "$unit" "$pkgdir/usr/lib/systemd/system/${unit##*/}"
  done
  install -Dm755 packaging/kde-rdp-setup.py "$pkgdir/usr/bin/kde-rdp-setup"
  install -Dm755 packaging/prepare-tls.py "$pkgdir/usr/lib/kde-rdp/prepare-tls"
  install -Dm644 packaging/kde-rdp.sysusers "$pkgdir/usr/lib/sysusers.d/kde-rdp.conf"
  install -Dm644 packaging/frontend.conf "$pkgdir/etc/kde-rdp/frontend.conf"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD-PARTY-NOTICES.txt "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.txt"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  for document in install acceptance upgrade uninstall performance; do
    install -Dm644 "docs/$document.md" "$pkgdir/usr/share/doc/$pkgname/$document.md"
  done
  install -Dm644 packaging/nvidia-frontend.conf "$pkgdir/usr/share/doc/$pkgname/nvidia-frontend.conf"
  # fail2ban examples; the package never enables them.
  install -Dm644 packaging/fail2ban/kde-rdp.conf "$pkgdir/usr/share/doc/$pkgname/fail2ban/kde-rdp.conf"
  install -Dm644 packaging/fail2ban/kde-rdp.jail.example "$pkgdir/usr/share/doc/$pkgname/fail2ban/kde-rdp.jail.example"
}
