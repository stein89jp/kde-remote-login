#%PAM-1.0
# Dedicated remote login policy for Fedora and Fedora Atomic (Bazzite); never
# modify plasmalogin, SDDM, GDM, sshd or another PAM service.
#
# This stack is written out in full instead of including password-auth: that
# file is generated by authselect and can change under us. It mirrors Fedora's
# sshd stack with authselect's password-auth and postlogin, with the same two
# changes as the Arch policy (broker/config/kde-rdp.pam):
#
# 1. Only members of kde-rdp-users with a regular UID may authenticate. The
#    check is "required", not "requisite": the rest of the stack still runs,
#    so a correct password for root or a non-member fails after the same
#    failure delay as a wrong password. That closes the timing oracle. The
#    broker repeats the group check after PAM.
# 2. pam_faillock uses a private tally directory and its own limits. Failed
#    RDP logins lock the account only for kde-rdp, never for the console,
#    sudo or other services. pam_faillock creates the directory on demand.
#    Reset an account with:
#      faillock --dir /run/faillock-kde-rdp --user NAME --reset
#
# As in sshd, pam_selinux moves the desktop into the account's SELinux login
# context (unconfined_t for ordinary users) instead of the broker's service
# domain. "close" must be the first session rule; only rules that should run
# in the user's context follow "open".
#
# Password expiration/MFA conversations are deliberately rejected by this v1
# broker, so there is no password stack.
auth      required                    pam_succeed_if.so    uid >= 1000 user ingroup kde-rdp-users quiet
auth      required                    pam_shells.so
auth      requisite                   pam_nologin.so
auth      required                    pam_env.so
auth      required                    pam_faildelay.so     delay=2000000
auth      required                    pam_faillock.so      preauth dir=/run/faillock-kde-rdp deny=5 unlock_time=300
auth      [success=1 default=bad]     pam_unix.so          nullok
auth      [default=die]               pam_faillock.so      authfail dir=/run/faillock-kde-rdp deny=5 unlock_time=300
auth      required                    pam_faillock.so      authsucc dir=/run/faillock-kde-rdp deny=5 unlock_time=300

account   required                    pam_sepermit.so
account   required                    pam_nologin.so
account   required                    pam_unix.so

session   required                    pam_selinux.so       close
session   required                    pam_loginuid.so
session   required                    pam_selinux.so       open
session   required                    pam_namespace.so
session   optional                    pam_keyinit.so       force revoke
session   required                    pam_limits.so
session   required                    pam_unix.so
session   optional                    pam_umask.so         silent
session   required                    pam_systemd.so       type=wayland class=user desktop=KDE
